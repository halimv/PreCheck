#!/usr/bin/env bash
# PreCheck from anywhere: runs pipeline.py of the repo this script sits in, with that repo's Python.
#   precheck protocol.pdf --yes
# Python is $PRECHECK_PYTHON if set, else the repo's .venv, else the conda env $PRECHECK_CONDA_ENV
# (default: bioinfo) when it exists, else python3.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "${1:-}" == "--root" ]]; then echo "$root"; exit 0; fi
if [[ -n "${PRECHECK_PYTHON:-}" ]]; then
  exec "$PRECHECK_PYTHON" "$root/pipeline.py" "$@"
elif [[ -x "$root/.venv/bin/python" ]]; then
  exec "$root/.venv/bin/python" "$root/pipeline.py" "$@"
elif command -v conda >/dev/null 2>&1 && conda env list 2>/dev/null | grep -qE "^${PRECHECK_CONDA_ENV:-bioinfo}[[:space:]]"; then
  exec conda run --no-capture-output -n "${PRECHECK_CONDA_ENV:-bioinfo}" python "$root/pipeline.py" "$@"
else
  exec python3 "$root/pipeline.py" "$@"
fi
